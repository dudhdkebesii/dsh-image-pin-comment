{
  "name": "dsh-image-pin-comment",
  "version": "0.2.1",
  "description": "Pin-and-comment annotation for the DeepSeek Harness image lightbox: drop numbered pins, type a note, and the original image plus a coordinate list lands in the composer. 图片图钉标注：在图片上钉图钉写评论，自动生成带坐标的说明一起发出去。",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "screenshots.json",
    "docs/preview.png"
  ],
  "scripts": {
    "check": "node --check lib/index.js && node --check lib/client.js",
    "test": "node test/smoke.mjs",
    "test:e2e": "node test/real-flow.mjs",
    "pack:dry": "npm pack --dry-run",
    "set-repo": "bash scripts/set-repo.sh"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [],
      "platform": "web"
    }
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dudhdkebesii/dsh-image-pin-comment.git"
  },
  "homepage": "https://github.com/dudhdkebesii/dsh-image-pin-comment#readme",
  "bugs": {
    "url": "https://github.com/dudhdkebesii/dsh-image-pin-comment/issues"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek",
    "deepseek-harness",
    "cordis",
    "plugin",
    "annotation",
    "pin",
    "comment",
    "image",
    "lightbox",
    "coordinate"
  ]
}
